OPENAI_API_KEY=sk-...
# OpenAI 相容端點（含 /v1）；留空或刪除即用 api.openai.com。目前暫用 Meta Muse：https://api.meta.ai/v1
OPENAI_BASE_URL=https://api.meta.ai/v1
# 模型 ID 必須存在於 src/main/resources/models/openai-models.yml；Meta 用 muse-spark-1.3-contributor，OpenAI 用 gpt-5.4-nano
MODEL=muse-spark-1.3-contributor
CF_TUNNEL_TOKEN=eyJ...
# 語意 MCP 預設關閉；開啟前須完成 OAuth／tools-list／服務條款 gate
LAWGRAPH_SEMANTIC_ENABLED=false
TW_LEGAL_RAG_URL=https://tlr.dr-legal.com.tw
TW_LEGAL_RAG_ENDPOINT=/mcp
# Zeabur 請改成實際公開網址，OAuth callback 必須固定此 origin
LAWGRAPH_PUBLIC_BASE_URL=http://localhost:8080
# 正式環境請指向僅此服務可存取的持久化 volume；本機預設為 .data 下的 owner-only 檔案
LAWGRAPH_OAUTH_SESSION_PATH=.data/tw-legal-rag-session.json
